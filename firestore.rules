rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all secure net to prevent unsolicited reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Leads secure schema match rule
    match /leads/{leadId} {
      // Allow creation through server/privileged actions, and protect PII/leads from query scrapers
      allow create: if true; // Public can submit through contact form
      allow read, delete: if false; // Only admin can read or delete, proxied via backend
    }
  }
}

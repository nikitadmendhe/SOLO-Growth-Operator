rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all secure net to prevent unsolicited reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Leads secure schema match rule
    match /leads/{leadId} {
      // Allow read and write access for server-bound operations
      allow read, write: if true;
    }
  }
}
